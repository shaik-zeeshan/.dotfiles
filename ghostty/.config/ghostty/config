# Background
background-opacity = 0.90
background-blur-radius = 40

# Padding
window-padding-x = 10
window-padding-y = 10,0
window-padding-balance = true

# Font
# font-family = ZedMono NFM
font-family = ZedMono
font-size = 14
adjust-cell-height = 2

# Theme
theme = 0x96f

# Macos
macos-titlebar-style = hidden
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = red
macos-icon-screen-color = red,black

macos-window-shadow = false

window-vsync = true

keybind = global:cmd+shift+alt+ctrl+n=toggle_quick_terminal

# Browser
link-url = true

command = env XDG_CONFIG_HOME="/Users/shaikzeeshan/.config" PATH="/opt/homebrew/bin:/Users/shaikzeeshan/tools:/usr/local/bin:$PATH" EDITOR="nvim" /opt/homebrew/bin/nu -l

